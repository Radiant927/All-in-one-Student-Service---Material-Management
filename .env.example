# 数据库配置
# 不设置则默认使用 SQLite (backend/data/inventory.db)
DATABASE_URL=sqlite:///backend/data/inventory.db
# PostgreSQL 示例: DATABASE_URL=postgresql://user:password@host:5432/inventory_db
POSTGRES_USER=inventory
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_DB=inventory_db

# 管理员初始密码
ADMIN_PASSWORD=admin888

# 运行环境: development / production
APP_ENV=development
JWT_SECRET=replace-with-a-long-random-secret
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=14

# 学校统一认证适配器尚未接入时，仅允许在 development 使用模拟认证
AUTH_PROVIDER=mock
MOCK_AUTH_ENABLED=true

# 允许访问后端的前端域名，多个域名用逗号分隔；生产环境禁止使用 *
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# 自动补货邮件，可选 daily / weekly / semimonthly / monthly / disabled
REPORT_SCHEDULE=disabled
REPORT_SCHEDULE_HOUR=8

# SMTP 邮件配置 (用于发送补货报表)
SMTP_HOST=smtp.qq.com
SMTP_PORT=587
SMTP_USER=your_email@qq.com
SMTP_PASSWORD=your_auth_code
SMTP_FROM=your_email@qq.com
REPORT_EMAIL_TO=procurement@example.com
